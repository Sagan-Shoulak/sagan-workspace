diff --git a/scripts/lock.sh b/scripts/lock.sh
new file mode 100644
index 0000000..56bab5d
--- /dev/null
+++ b/scripts/lock.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$repo_root"
+for candidate in python3 python py; do
+  if command -v "$candidate" >/dev/null 2>&1; then
+    exec "$candidate" scripts/workspace.py lock "$@"
+  fi
+done
+echo "Python 3.11 or newer is required for workspace.toml." >&2
+exit 1
