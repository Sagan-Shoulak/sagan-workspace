{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagan.shoulak.org/schemas/extraction-plan-v1.json",
  "title": "Sagan extraction plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "source_roots", "documentation_mount", "artifact_kinds"],
        "properties": {
          "id": { "type": "string", "pattern": "^sagan(?:-[a-z0-9]+)*$" },
          "phase": { "type": "integer", "minimum": 1 },
          "source_roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "documentation_mount": { "type": "string", "pattern": "^/.*" },
          "artifact_kinds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
