{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagan.shoulak.org/schemas/chat-map-v1.json",
  "title": "Sagan specialized chat map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chats", "handoff"],
  "properties": {
    "schema_version": { "const": 1 },
    "chats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "owns"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "repository": { "type": "string", "pattern": "^sagan(?:-[a-z0-9]+)*$" },
          "owns": { "type": "string", "minLength": 1 }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "instruction"],
      "properties": {
        "required_fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "instruction": { "type": "string", "minLength": 1 }
      }
    }
  }
}
