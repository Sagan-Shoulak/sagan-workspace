{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagan.shoulak.org/schemas/workspace-lock-v1.json",
  "title": "Sagan workspace lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repositories"],
  "properties": {
    "schema_version": { "const": 1 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "commit"],
        "properties": {
          "id": { "type": "string", "pattern": "^sagan(?:-[a-z0-9]+)*$" },
          "url": { "type": "string", "format": "uri" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "version": { "type": ["string", "null"] },
          "artifact_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
