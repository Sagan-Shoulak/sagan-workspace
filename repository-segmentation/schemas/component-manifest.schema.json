{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagan.shoulak.org/schemas/component-manifest-v1.json",
  "title": "Sagan component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component", "version", "repository", "artifacts", "compatibility", "documentation"],
  "properties": {
    "schema_version": { "const": 1 },
    "component": { "type": "string", "pattern": "^sagan(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "repository": { "type": "string", "pattern": "^Sagan-Shoulak/[A-Za-z0-9._-]+$" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "platform"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["source", "package", "executable", "extension", "installer", "documentation"] },
          "platform": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "documentation": { "$ref": "documentation-export.schema.json" }
  }
}
