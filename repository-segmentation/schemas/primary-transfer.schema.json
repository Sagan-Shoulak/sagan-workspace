{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagan.shoulak.org/schemas/primary-transfer-v1.json",
  "title": "Sagan primary repository transfer inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "destination",
    "required_default_branch",
    "required_visibility",
    "split_repository_creation_blocked_until_verified",
    "local_remote",
    "github",
    "legacy_references",
    "external_integrations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "const": "JoePShoulak/sagan" },
    "destination": { "const": "Sagan-Shoulak/sagan" },
    "required_default_branch": { "const": "dev" },
    "required_visibility": { "const": "public" },
    "split_repository_creation_blocked_until_verified": { "const": true },
    "local_remote": {
      "type": "object",
      "required": ["name", "before", "after"]
    },
    "github": {
      "type": "object",
      "required": [
        "environments",
        "secret_names",
        "deferred_signing_secret_names",
        "transfer_policy",
        "release_policy",
        "self_hosted_runner_labels",
        "workflows"
      ],
      "properties": {
        "transfer_policy": { "const": "preserve-observed-settings-before-tightening" },
        "release_policy": { "const": "paused-until-owner-decides-publication-policy" }
      }
    },
    "legacy_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose"]
      }
    },
    "external_integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "verification"]
      }
    }
  }
}
