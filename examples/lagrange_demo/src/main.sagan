    circle(secondary.x, secondary.y, 10.0, 96, 165, 250)
    circle(first.x, first.y, 5.0, 244, 114, 182)
    circle(second.x, second.y, 5.0, 251, 146, 60)
    circle(third.x, third.y, 5.0, 167, 139, 250)
    circle(fourth.x, fourth.y, 5.0, 74, 222, 128)
    circle(fifth.x, fifth.y, 5.0, 34, 211, 238)
    circle(control.x, control.y, 5.0, 248, 113, 113)
    text(primary.x + 14.0, primary.y - 16.0, "Primary", 12, 250, 204, 21)
    text(secondary.x + 10.0, secondary.y - 16.0, "Secondary", 12, 96, 165, 250)
    text(first.x + 8.0, first.y - 14.0, "L1", 11, 244, 114, 182)
    text(second.x + 8.0, second.y - 14.0, "L2", 11, 251, 146, 60)
    text(third.x + 8.0, third.y - 14.0, "L3", 11, 167, 139, 250)
    text(fourth.x + 8.0, fourth.y - 14.0, "L4", 11, 74, 222, 128)
    text(fifth.x + 8.0, fifth.y - 14.0, "L5", 11, 34, 211, 238)
    text(control.x + 8.0, control.y - 14.0, "Control", 11, 248, 113, 113)

    text_screen(20, 18, "R3 Lagrange stability — six independent massless tracers", 17, 226, 232, 240)
    text_screen(20, 45, "Space play/pause | Wheel zoom | Up/Down speed (max 40 days/s) | R reset | Escape close", 12, 148, 163, 184)
    text_screen(20, 68, "elapsed simulation time: ${elapsed_display(elapsed_steps)}", 12, 148, 210, 189)
    text_screen(20, 88, "selected simulation rate: ${simulation_seconds_per_real_second / 86400.0} simulated days / real second", 12, 148, 210, 189)
    text_screen(20, 108, "zoom: ${kilometers_per_pixel} km / pixel", 12, 148, 210, 189)
    text_screen(20, 138, "L1 error: ${viewport_stability_display(current.tertiary(0), current, first)}", 11, 244, 114, 182)
    text_screen(20, 158, "L2 error: ${viewport_stability_display(current.tertiary(1), current, second)}", 11, 251, 146, 60)
    text_screen(20, 178, "L3 error: ${viewport_stability_display(current.tertiary(2), current, third)}", 11, 167, 139, 250)
    text_screen(20, 198, "L4 error: ${viewport_stability_display(current.tertiary(3), current, fourth)}", 11, 74, 222, 128)
    text_screen(20, 218, "L5 error: ${viewport_stability_display(current.tertiary(4), current, fifth)}", 11, 34, 211, 238)
    text_screen(20, 238, "Control error: ${viewport_stability_display(current.tertiary(5), current, control)}", 11, 248, 113, 113)
    present()
  }
  print("final_playback_rate ${simulation_seconds_per_real_second}")
  print("final_simulation_rate_days_per_real_second ${simulation_seconds_per_real_second / 86400.0}")
  print("final_kilometers_per_pixel ${kilometers_per_pixel}")
  close()
}

print("final_time_s ${current.time()}")
print("final_elapsed ${current.time() as day}")
print("final_elapsed_display ${elapsed_display(elapsed_steps)}")
print("final_L1_error ${stability_display(current.tertiary(0))}")
print("final_L2_error ${stability_display(current.tertiary(1))}")
print("final_L3_error ${stability_display(current.tertiary(2))}")
print("final_L4_error ${stability_display(current.tertiary(3))}")
print("final_L5_error ${stability_display(current.tertiary(4))}")
print("final_control_error ${stability_display(current.tertiary(5))}")
