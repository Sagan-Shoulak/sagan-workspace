    line(third_trail.point_six().x, third_trail.point_six().y, third_trail.point_seven().x, third_trail.point_seven().y, 2.0, 167, 139, 250)
    line(third_trail.point_seven().x, third_trail.point_seven().y, third_trail.point_eight().x, third_trail.point_eight().y, 2.0, 167, 139, 250)

    line(fourth_trail.point_one().x, fourth_trail.point_one().y, fourth_trail.point_two().x, fourth_trail.point_two().y, 2.0, 74, 222, 128)
